{
  "name": "pbi-validator",
  "version": "1.0.0",
  "description": "Power BI end-to-end report validation & visual regression platform",
  "main": "src/server.js",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/server.js",
    "cli": "node --disable-warning=ExperimentalWarning src/cli.js",
    "login": "node --disable-warning=ExperimentalWarning src/cli.js login",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 test/*.test.js",
    "install:browsers": "playwright install chromium"
  },
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "archiver": "^8.0.0",
    "croner": "^11.0.0",
    "express": "^5.3.0",
    "htm": "^3.1.1",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.65.0",
    "pngjs": "^7.0.0",
    "preact": "^11.2.0",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22.13"
  },
  "private": true
}
