# Copy to .env and adjust. Real environment variables take precedence.

# Where the web UI listens. Keep 127.0.0.1 unless you also set API_TOKEN.
HOST=127.0.0.1
PORT=4400

# Database, screenshots and saved sessions live here.
DATA_DIR=./data

# Admin-level Bearer token for scripts/CI, and the "setup token" that allows
# creating the first administrator remotely (e.g. through a tunnel).
# People sign in with their own accounts; see the Accounts section below.
API_TOKEN=

# How many validation runs execute at the same time (each uses 1 Chromium with 2 tabs).
MAX_PARALLEL_RUNS=1

# Set to false to watch the browser while debugging a suite.
HEADLESS=true

# Runs (and their screenshots) older than this are purged nightly. 0 = keep forever.
RUN_RETENTION_DAYS=30

# Default page for the interactive sign-in window (change for sovereign clouds,
# e.g. https://app.powerbigov.us/home).
PBI_LOGIN_URL=https://app.powerbi.com/home

LOG_LEVEL=info

# ------------------------------------------------------------------- Accounts
# The first visit on this machine (http://127.0.0.1:4400) creates the first
# administrator; or run: npm run cli -- create-admin you@company.com
# The address people use when it's served through a tunnel/proxy/custom domain
# (also editable in Admin → Settings; a value here locks that field).
PUBLIC_URL=
# Sign people out after this many idle hours, and after at most this many days.
SESSION_IDLE_HOURS=72
SESSION_MAX_DAYS=30
PASSWORD_MIN_LENGTH=10

# Time zone for suite schedules (cron times) and dates in PDF/Excel exports.
TIMEZONE=Asia/Kolkata
# A scheduled run missed while the app was offline/asleep runs once on the next
# start, unless it is older than this many hours.
SCHEDULE_CATCHUP_HOURS=24

# Optional: service principal for reading data models through the Power BI REST
# API (data model comparison). Needs Build permission on the semantic models.
# Without it, the report link's signed-in Power BI session is used, or an
# uploaded model file (.pbit / model.bim / TMDL).
PBI_TENANT_ID=
PBI_CLIENT_ID=
PBI_CLIENT_SECRET=
# Automatically generated temporary passwords (new users, resets) expire after this many hours.
TEMP_PASSWORD_HOURS=72
# Failed sign-ins per IP + email within 15 minutes before a temporary block.
LOGIN_MAX_ATTEMPTS=8

# ---------------------------------------------------------------- AI analysis
# Open-weight models via NVIDIA's API catalog. Free key: https://build.nvidia.com
# (sign in → any model → "Get API Key"). Leave empty to disable AI features.
NVIDIA_API_KEY=
# Any OpenAI-compatible endpoint works. Point this at a self-hosted NVIDIA NIM
# (e.g. http://nim.internal:8000/v1) to keep report data inside your network.
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_TEXT_MODEL=nvidia/nemotron-3-ultra-550b-a55b
AI_VISION_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
# Analyse automatically when a run finishes.
AI_AUTO_ANALYZE=true
# The AI works from the values of the reports, not from their pictures. Screenshots
# are sent only for suites that turn on "Also describe look-only differences from
# screenshots". Set false to never send any screenshot to the AI endpoint.
AI_ALLOW_IMAGES=true
AI_MAX_VISION_ITEMS=8
# Set true for a self-hosted endpoint that needs no API key.
AI_ALLOW_NO_KEY=false

# ----------------------------------------------------------------- Cloudflare
# Only for docker-compose.yml (remotely-managed tunnel token from the dashboard).
TUNNEL_TOKEN=
